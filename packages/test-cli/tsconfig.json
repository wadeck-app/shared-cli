{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"outDir": "dist",
		"rootDir": ".",
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmitOnError": true
	},
	"include": ["src", "tests"],
	"exclude": ["dist", "node_modules"]
}
