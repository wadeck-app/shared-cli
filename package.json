{
	"name": "@wadeck-app/shared-cli",
	"version": "0.1.0",
	"type": "module",
	"workspaces": ["packages/*"],
	"repository": {
		"type": "git",
		"url": "https://github.com/wadeck-app/shared-cli.git"
	},
	"publishConfig": {
		"@wadeck-app:registry": "https://npm.pkg.github.com/"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/cjs/index.js",
			"types": "./dist/index.d.ts"
		},
		"./ConfigDir": {
			"import": "./dist/ConfigDir.js",
			"require": "./dist/cjs/ConfigDir.js",
			"types": "./dist/ConfigDir.d.ts"
		},
		"./UpdateManager": {
			"import": "./dist/UpdateManager.js",
			"require": "./dist/cjs/UpdateManager.js",
			"types": "./dist/UpdateManager.d.ts"
		},
		"./HookDispatcher": {
			"import": "./dist/HookDispatcher.js",
			"require": "./dist/cjs/HookDispatcher.js",
			"types": "./dist/HookDispatcher.d.ts"
		},
		"./VersionValidation": {
			"import": "./dist/VersionValidation.js",
			"require": "./dist/cjs/VersionValidation.js",
			"types": "./dist/VersionValidation.d.ts"
		},
		"./Duration": {
			"import": "./dist/Duration.js",
			"require": "./dist/cjs/Duration.js",
			"types": "./dist/Duration.d.ts"
		},
		"./CliLogger": {
			"import": "./dist/CliLogger.js",
			"require": "./dist/cjs/CliLogger.js",
			"types": "./dist/CliLogger.d.ts"
		},
		"./NpmRunner": {
			"import": "./dist/NpmRunner.js",
			"require": "./dist/cjs/NpmRunner.js",
			"types": "./dist/NpmRunner.d.ts"
		},
		"./CliMetaCommands": {
			"import": "./dist/CliMetaCommands.js",
			"require": "./dist/cjs/CliMetaCommands.js",
			"types": "./dist/CliMetaCommands.d.ts"
		},
		"./ChannelConfig": {
			"import": "./dist/ChannelConfig.js",
			"require": "./dist/cjs/ChannelConfig.js",
			"types": "./dist/ChannelConfig.d.ts"
		}
	},
	"main": "./dist/cjs/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"tsconfig.cjs.json"
	],
	"scripts": {
		"build": "tsc && tsc -p tsconfig.cjs.json && printf '{\"type\":\"commonjs\"}\\n' > dist/cjs/package.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"preversion": "node -e \"if (!process.env.CI) { console.error('ERROR: version is CI-managed. Do not run npm version manually.'); process.exit(1); }\""
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^7.0.0",
		"vitest": "^4.0.14"
	}
}
